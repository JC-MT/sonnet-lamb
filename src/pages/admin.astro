---
import BaseLayout from "../layouts/BaseLayout.astro";
import { DraggableButton } from "../components/DragableButton.jsx";
---

<BaseLayout>
  <section class="flex gap-5 md:gap-10 px-5 pb-5 text-fg md:p-10">
    <aside class="w-1/4">Admin Page Aside
    <DraggableButton client:visible>
      <div slot="fallback">Loading</div>
    </DraggableButton>
    </aside>
    <div class="w-3/5 flex justify-center items-center">
      <div
        pdf-content
        class="shadow-2xl bg-white relative size-full aspect-297/210"
      >
        <div class="flex flex-col gap-5 h-full p-4">
          <div class="flex justify-between gap-5">
            <div class="text-[rgb(230,157,177)] font-semibold text-2xl">
              Birth
            </div>
            <div class="font-semibold text-base flex gap-2 items-center">
              <div
                class="size-28 flex flex-col rounded-full p-5 bg-[rgb(255,229,236)] text-[rgb(230,157,177)] font-semibold tracking-tight"
              >
                <span>Aldyn</span>
                <span>Mom</span>
              </div>
              <div
                class="size-28 flex flex-col rounded-full p-5 bg-[#a2c6ae] text-white font-semibold tracking-tight"
              >
                <span>Bennet</span>
                <span>Dad</span>
              </div>
              <div
                class="size-28 flex flex-col rounded-full p-5 bg-[rgb(255,229,236)] text-[rgb(230,157,177)] font-semibold tracking-tight"
              >
                <span>Sonnet</span>
                <span>Doula</span>
              </div>
            </div>
          </div>
          <div class="flex gap-5 h-full">
            <div class="min-w-60 text-center">
              <div
                class="p-2 bg-[rgb(255,229,236)] text-[rgb(230,157,177)] font-semibold text-2xl tracking-tight"
              >
                PRE-LABOR
              </div>
              <div
                class="size-full border-dotted border-4 border-[#a2c6ae] p-2 max-h-[calc(100%-3rem)] mt-0.5"
              >
                (for testing purposes only)
              </div>
            </div>
            <div class="w-full text-center">
              <div
                class="p-2 bg-[rgb(255,229,236)] text-[rgb(230,157,177)] font-semibold text-2xl tracking-tight"
              >
                ENVIRONMENT
              </div>
              <div
                class="size-full border-dotted border-4 border-[#a2c6ae] p-2 max-h-[calc(100%-3rem)] mt-0.5"
              >
                <div class="size-full">(for testing purposes only)</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
